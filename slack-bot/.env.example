# Slack bot tokens (get from https://api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-token-here

# Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Comma-separated list of Slack user IDs allowed to use the bot
# Find yours: Slack profile → More → Copy member ID
ALLOWED_SLACK_USER_IDS=U01ABC123

# Path to your Claude Code project (where .claude/skills/ and .mcp.json live)
CLAUDE_PROJECT_DIR=/home/user/claude-code

# Optional: override default model
CLAUDE_MODEL=claude-opus-4-6
