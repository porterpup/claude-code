.mcp.grantdrive.json

# Notion workspace map — generated by scripts/bootstrap-notion.py; contains
# teamspace/database IDs specific to the running user's Notion workspace.
# Bootstrap script is the committed source of truth; the map is local.
.claude/notion-workspace-map.json

# Slack bot tokens for the agent swarm — never commit.
slack-agents/.env.slack

# Temporary files
tmp/
temp/


